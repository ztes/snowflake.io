{
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",  // 用 ESM 输出
        "moduleResolution": "node",
        "esModuleInterop": true,  // 关键：支持 CJS/ESM 互操作
        "outDir": "./lib",
        "declaration": true,
        "strict": true,
        "lib": ["esnext", "dom"],
        "types": ["node"]
    },
    "include": ["src/**/*"]
}
