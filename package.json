{
    "name": "snowflake.io",
    "version": "2.0.0",
    "type": "module",
    "main": "./lib/index.js",
    "module": "./lib/index.js",
    "description": "High-performance distributed unique ID generator based on Twitter's Snowflake algorithm. Supports ESM and CommonJS with BigInt for precision.",
    "scripts": {
        "build:pkg": "rm -rf lib && tsc",
        "create": "tsc",
        "dev": "set NODE_ENV=development && tsc --watch",
        "build": "tsc",
        "eslint:fix": "./node_modules/.bin/eslint --fix ./",
        "publish": "npm publish --access=public",
        "test": "node lib/test.js",
        "test:example": "node src/distributed-example.mjs"
    },
    "exports": {
        ".": {
            "require": "./lib/index.js",
            "import": "./lib/index.js",
            "types": "./lib/index.d.ts"
        },
        "./package.json": "./package.json"
    },
    "types": "./lib/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/ztes/snowflake.io.git"
    },
    "bugs": {
        "url": "https://github.com/ztes/snowflake.io/issues"
    },
    "author": "ztes.com <xy@ztes.com>",
    "blog": "https://ztes.com",
    "homepage": "https://github.com/ztes/snowflake.io#readme",
    "keywords": [
        "snowflake",
        "snowflake.io",
        "snowflake-id",
        "snowflake id",
        "flake-id",
        "unique-id",
        "distributed",
        "distributed-systems",
        "id-generator",
        "unique-id-generator",
        "distributed-id",
        "twitter-snowflake",
        "bigint",
