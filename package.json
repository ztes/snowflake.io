        "clock-skew",
        "high-performance",
        "scalable",
        "uuid-alternative",
        "雪花算法",
        "雪花id",
        "分布式id",
        "唯一id",
        "分布式系统",
        "id生成器",
        "后端",
        "backend"
    ],
    "license": "MIT",
