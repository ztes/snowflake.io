{
    "name": "snowflake.io",
    "version": "0.0.0-alpha.8",
    "type": "module",
    "main": "./framework/cjs/snowflake.io.cjs",
    "module": "./framework/es/snowflake.io.js",
    "description": "Snowflake.io, generates k-ordered, conflict-free snowflake IDs in a distributed environment.",
    "scripts": {
        "build:pkg": "rm -rf framework && rollup --config rollup.config.js",
        "create": "tsc",
        "dev": "set NODE_ENV=developemnt&& rollup -c rollup.config.js -w",
        "build": "rollup -c rollup.config.js",
        "eslint:fix": "./node_modules/.bin/eslint --fix ./",
        "publish": "npm publish --access=public"
    },
    "exports": {
        ".": {
            "require": "./framework/cjs/snowflake.io.cjs",
            "import": "./framework/es/snowflake.io.js"
        }
    },
    "types": "./framework/es/index.d.ts",
    "repository": {
        "type": "git",
        "url": "https://github.com/ztes/snowflake.io.git"
    },
    "bugs": {
        "url": "https://github.com/ztes/snowflake.io/issues"
    },
    "author": "ztes.com <xy@ztes.com>",
    "blog": "https://ztes.com",
    "keywords": [
        "snowflake",
        "snowflake.io",
        "snowflake-id",
        "snowflake id",
        "flake-id",
        "雪花算法",
        "雪花id",
        "backend"
    ],
    "license": "MIT",
    "devDependencies": {
        "@babel/core": "^7.18.6",
        "@babel/preset-env": "^7.15.8",
        "@rollup/plugin-babel": "^6.0.4",
        "@rollup/plugin-commonjs": "^28.0.3",
        "@rollup/plugin-json": "^6.0.0",
        "@rollup/plugin-node-resolve": "^16.0.1",
        "@types/node": "^18.7.6",
        "@types/qs": "^6.9.7",
        "@types/webpack-env": "^1.17.0",
        "@typescript-eslint/eslint-plugin": "^5.59.2",
        "@typescript-eslint/parser": "^5.0.0",
        "core-js": "3",
        "eslint": "^8.17.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-define-config": "^1.5.0",
        "eslint-plugin-prettier": "^4.0.0",
        "prettier": "^2.8.8",
        "rollup": "^2.79.1",
        "rollup-plugin-commonjs": "^10.1.0",
        "rollup-plugin-copy": "^3.5.0",
        "rollup-plugin-dts": "^4.2.2",
        "rollup-plugin-eslint": "^7.0.0",
        "rollup-plugin-node-resolve": "^5.2.0",
        "rollup-plugin-terser": "^7.0.2",
        "rollup-plugin-typescript": "^1.0.1",
        "rollup-plugin-typescript2": "^0.31.1",
        "rollup-plugin-uglify": "^6.0.4",
        "typescript": "^4.4.4"
    },
    "files": ["framework/**/*", "README.md"],
    "dependencies": {
        "bigint-conversion": "^2.4.3"
    }
}
